# OpenHD hardware.config - Radxa Dragon Q6A air unit
# Requires /usr/local/share/openhd/debug.txt to be honoured (2.6.4 gate).
[wifi]
WIFI_ENABLE_AUTODETECT = false
# TP-Link Archer T3U Plus (2357:0138) on rtl88x2bu_ohd - wifibroadcast link
WIFI_WB_LINK_CARDS = wlx20e15d3dc150
# onboard AIC8800 wlan0 stays with NetworkManager (DroneNet hotspot); OpenHD makes no hotspot
WIFI_WIFI_HOTSPOT_CARD =
WIFI_MONITOR_CARD_EMULATE = false
WIFI_FORCE_NO_LINK_BUT_HOTSPOT = false
WIFI_LOCAL_NETWORK_ENABLE = false
WIFI_LOCAL_NETWORK_SSID =
WIFI_LOCAL_NETWORK_PASSWORD =

[network]
NW_ETHERNET_CARD =
NW_MANUAL_FORWARDING_IPS =
NW_FORWARD_TO_LOCALHOST_58XX = false
